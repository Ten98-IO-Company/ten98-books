{
  "name": "ten98-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3410 --strictPort",
    "check:architecture": "node node_modules/@ten98/runtime/check.mjs .",
    "build": "pnpm check:architecture && pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm check:architecture && node --test --test-concurrency=2 tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.integration.ts",
    "setup:local": "node src/server/cli.ts setup",
    "migrate": "node --env-file-if-exists=.env src/server/cli.ts migrate",
    "worker": "node --env-file-if-exists=.env src/server/cli.ts worker"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@ten98/runtime": "file:vendor/ten98-runtime-0.26.0.tgz",
    "@ten98/ui": "file:vendor/ten98-ui-0.37.0.tgz",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.2",
    "nodemailer": "10.1.4",
    "pg": "8.23.0",
    "pg-boss": "12.37.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "nitro": "3.0.260903-beta",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
