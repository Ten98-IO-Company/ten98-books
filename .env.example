# ten98-books local development environment template.
#
# Generate a real .env with:
#   pnpm run setup:local
# It writes random secrets and refuses to overwrite an existing .env. Never use these placeholders as-is.
# There is no default admin password: the first account created in the UI becomes the owner.

APP_URL=http://localhost:3410
APP_PORT=3410
POSTGRES_PORT=55432

# Compose: the PostgreSQL superuser (cluster setup only) and the two roles of D-03.
POSTGRES_PASSWORD=replace-with-generated-random-value
BOOKS_MIGRATOR_PASSWORD=replace-with-generated-random-value
BOOKS_APP_PASSWORD=replace-with-generated-random-value

# Host-run web and worker (pnpm dev, the built server, pnpm worker). Compose injects its own internal URLs.
# DATABASE_URL is the non-owner application role; MIGRATION_DATABASE_URL is the owner role and is used only to migrate.
DATABASE_URL=postgresql://books_app:replace-with-generated-random-value@localhost:55432/books
MIGRATION_DATABASE_URL=postgresql://books_migrator:replace-with-generated-random-value@localhost:55432/books

AUTH_SECRET=replace-with-generated-random-value

# Local development only: with MIGRATE_ON_START unset or true, a host-run web or worker that has MIGRATION_DATABASE_URL
# applies pending migrations before starting, under one advisory lock. Compose never gives web and worker the owner role:
# its one-shot migrate service migrates, and web and worker run with MIGRATE_ON_START=false, waiting up to 5 minutes for
# the schema.
# MIGRATE_ON_START=true

# Reverse proxies whose X-Forwarded-For identifies the client for per-client rate limits. Empty: the peer is the client.
# TRUSTED_PROXIES=172.18.0.2

# Integration tests only: a superuser on the same local server, used to create and drop throwaway databases.
# TEST_ADMIN_DATABASE_URL=postgresql://books_admin:replace-with-generated-random-value@localhost:55432/postgres

# Instance-wide transactional email (password recovery, invitations). Disabled until configured. Each send is one
# bounded attempt over authenticated TLS 1.2+; starttls uses port 587 by default, tls 465.
EMAIL_TRANSPORT=disabled
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=accounts@example.com
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_TLS=starttls
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=replace-with-smtp-username
# EMAIL_SMTP_PASSWORD=replace-with-smtp-password
# EMAIL_FROM, EMAIL_SMTP_HOST, EMAIL_SMTP_USER and EMAIL_SMTP_PASSWORD also accept an exclusive _FILE alternative.
